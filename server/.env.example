# Porta do servidor backend
PORT=5000

# local ou microsoft. No modo microsoft não há cadastro/senha local.
AUTH_PROVIDER=local
ENTRA_TENANT_ID=
# ID do aplicativo API; tokens v2 usam este GUID como audience.
ENTRA_API_CLIENT_ID=
# ID do aplicativo SPA autorizado a chamar a API.
ENTRA_CLIENT_ID=

# PostgreSQL/RDS. O caminho do certificado é relativo à pasta server.
PGHOST=systems.cho1rljqtj4r.sa-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=inventorycontrol
PGUSER=postgres
PGPASSWORD=SUBSTITUA_PELA_SENHA_DO_RDS
PGSSLROOTCERT=certs/global-bundle.pem

# Gere uma chave aleatória forte antes de executar em qualquer ambiente publicado
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO

# Conta administradora criada no primeiro início do servidor
ADMIN_EMAIL=admin@donato.com.br
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
ADMIN_NAME=Administrador Donato

# Envio do PDF assinado pelo Microsoft Graph. Ative após aplicar os SQLs 006 e 007.
MAIL_ENABLED=false
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_FROM_EMAIL=
