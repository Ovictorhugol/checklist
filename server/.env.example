# Porta do servidor backend
PORT=5000

ENTRA_TENANT_ID=
# ID do aplicativo API; tokens v2 usam este GUID como audience.
ENTRA_API_CLIENT_ID=
# ID do aplicativo SPA autorizado a chamar a API.
ENTRA_CLIENT_ID=

# PostgreSQL/RDS. O caminho do certificado é relativo à pasta server.
PGHOST=systems.cho1rljqtj4r.sa-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=inventorycontrol
PGUSER=postgres
PGPASSWORD=SUBSTITUA_PELA_SENHA_DO_RDS
PGSSLROOTCERT=certs/global-bundle.pem

# Envio do PDF assinado pelo Microsoft Graph. Ative após aplicar os SQLs 006 e 007.
MAIL_ENABLED=false
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_FROM_EMAIL=

# GLPI 10: habilite após SQL 008 e glpi:check confirmar a categoria.
GLPI_ENABLED=false
GLPI_BASE_URL=http://suporte.donatoholhos.com.br
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_CATEGORY_NAME=Hardware
# Opcionais: informe categoria se houver mais de uma com esse nome.
GLPI_CATEGORY_ID=
# Vazio usa a entidade ativa do usuário da API. Zero é a entidade raiz.
GLPI_ENTITY_ID=
# Vazio preserva as regras de atribuição do GLPI.
GLPI_GROUP_ID=
