# Porta do servidor backend
PORT=5000

# String de Conexão do MongoDB (Substitua pela sua string do MongoDB Atlas ou local)
# Exemplo local: mongodb://localhost:27017/checklist_donato
# Exemplo Atlas: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/checklist_donato?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:SUA_SENHA_AQUI@cluster0.mongodb.net/checklist_donato?retryWrites=true&w=majority

# Gere uma chave aleatória forte antes de executar em qualquer ambiente publicado
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO

# Conta administradora criada no primeiro início do servidor
ADMIN_EMAIL=admin@donato.com.br
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
ADMIN_NAME=Administrador Donato
